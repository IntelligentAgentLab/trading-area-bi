# 환경변수/키
.env

# 원본 데이터 (대용량, 개인 API 키로 받거나 수동 다운로드한 데이터)
data/raw/*
!data/raw/.gitkeep
!data/raw/bigkinds/
data/raw/bigkinds/*
!data/raw/bigkinds/README.md
# 서울 상권·상품권 데이터는 용량이 작고 Actions가 매주 확인해 자동 갱신·커밋하므로 예외로 포함한다
!data/raw/seoul_trading_area/

# 파이썬
__pycache__/
*.pyc

# 캐시/임시
.DS_Store
~$*.xlsx
.download_*
*.tmp
/_watch_test/
/update_report.md

# 문서 (별도 공유, 레포에는 안 올림)
/docs/

# 팀 내부 계획 문서 (레포에는 코드만 — 별도 공유)
/0. 계획.pdf
/PowerBI_vs_Streamlit_비교.pdf
/소비상권_BI_프로젝트_설계안.pdf
/소비상권_공공데이터_비교표.xlsx
/프로젝트_실행계획서.pdf
